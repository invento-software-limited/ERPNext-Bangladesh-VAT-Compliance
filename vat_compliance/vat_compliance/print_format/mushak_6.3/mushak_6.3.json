 "html": "{% set month = [\"\u09aa\u09cd\u09b0\u09a5\u09ae \",\"\u09a6\u09cd\u09ac\u09bf\u09a4\u09c0\u09af\u09bc\", \"\u09a4\u09c3\u09a4\u09c0\u09af\u09bc\"] %}\n{% for n in month %}\n<div class=\"section-break\" data-label=\"\"> \n<div class=\"\">\n    <div id=\"header-html\" class=\"hidden-pdf\"> \n        <div class=\"row section-break\">\n            <div class=\"col-xs-2 text-left\">\n                <div class=\"logo\">\n                    <img style=\"width: 64px;\" src=\"/assets/vat_compliance/img/govt_logo.png\">\n                </div>\n            </div>\n            <div class=\"col-xs-8 text-center\">\n                <h4 style=\"padding:0px; margin:1px;font-size:14px\"><b>\u0997\u09a3\u09aa\u09cd\u09b0\u099c\u09be\u09a4\u09a8\u09cd\u09a4\u09cd\u09b0\u09c0 \u09ac\u09be\u0982\u09b2\u09be\u09a6\u09c7\u09b6 \u09b8\u09b0\u0995\u09be\u09b0</b></h4>\n                <h4 style=\"padding:0px; margin:1px;font-size:14px\"><b>\u099c\u09be\u09a4\u09c0\u09af\u09bc \u09b0\u09be\u099c\u09b8\u09cd\u09ac \u09ac\u09cb\u09b0\u09cd\u09a1</b></h4> <br>\n                <h4 style=\"padding:0px; margin:1px;font-size:14px\">\u0995\u09b0 \u099a\u09be\u09b2\u09be\u09a8\u09aa\u09a4\u09cd\u09b0</h4>\n                <p style=\"padding:0px;margin:1px;font-size:11px\">[ \u09ac\u09bf\u09a7\u09bf \u09ea\u09e6 \u098f\u09b0 \u0989\u09aa-\u09ac\u09bf\u09a7\u09bf (\u09e7) \u098f\u09b0 \u09a6\u09ab\u09be (\u0997) \u0993 \u09a6\u09ab\u09be (\u099a) \u09a6\u09cd\u09b0\u09b7\u09cd\u099f\u09ac\u09cd\u09af ]</p>\n            </div>\n            <div class=\"col-xs-2 text-right\">\n                <br>\n                <p style=\"padding:0px; margin:1px; border:1px solid black; text-align:center;font-weight:bold;font-size:10px\">\u09ae\u09c2\u09b8\u0995 \u09ec.\u09e9 {% if doc.docstatus == 0 %} [Draft] {%endif%}</p>\n                <p style=\"padding:0px; margin:1px;font-size:10px\">{{ n }} \u0995\u09aa\u09bf</p>\n            </div>\n        </div>\n        <div class=\"row section-break\" style=\"font-size: 11px;\">\n            <div class=\"col-xs-3\"></div>\n            <div class=\"row col-xs-9 text-left\" style=\"margin-top: 5px !important;\">\n                <div>\n                    <div class=\"col-xs-4\" style=\"font-weight:bold;\">\n                        <p style=\"font-size:11px\">\u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u09b0 \u09a8\u09be\u09ae</p>\n                    </div>\n                    <div class=\"col-xs-8\">\n                        <p style=\"font-size:11px\">: {{ doc.company or \"\" }}</p>\n                    </div>\n                    <div class=\"col-xs-4\" style=\"font-weight:bold;\">\n                        <p  style=\"font-size:11px\">\u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u09b0 \u09ac\u09bf\u0986\u0987\u098f\u09a8</p>\n                    </div>\n                    <div class=\"col-xs-8\">\n                        <p  style=\"font-size:11px\">: {{ doc.company_tax_id or \"\" }}</p>\n                    </div>\n                    <div class=\"col-xs-4\" style=\"font-weight:bold;\">\n                        <p  style=\"font-size:11px\">\u099a\u09be\u09b2\u09be\u09a8\u09aa\u09a4\u09cd\u09b0 \u0987\u09b8\u09cd\u09af\u09c1\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be</p>\n                    </div>\n                    <div class=\"col-xs-8\">\n                        {% if doc.company_address_display %}\n                        {% endif %}\n                        <p  style=\"font-size:11px\">: {{ doc.company_address_display or \"\" }}</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"row section-break\" style=\"font-size: 10px;\">\n        <div class=\"col-xs-7 text-left\">\n            <div class=\"row\" style= \"line-height: 14px; margin-top: 3px !important;\">\n                <div class=\"col-xs-4 customer-info\" style=\"font-weight: bold;\">\n                    <p>\u0995\u09cd\u09b0\u09c7\u09a4\u09be\u09b0 \u09a8\u09be\u09ae</p>\n                </div>\n                <div class=\"col-xs-8 padding-left-none\">\n                    <p>: {{ doc.customer_name }}</p>\n                </div>\n                <div class=\"col-xs-4 customer-info\" style=\"font-weight: bold;\">\n                    <p>\u0995\u09cd\u09b0\u09c7\u09a4\u09be\u09b0 \u09ac\u09bf\u0986\u0987\u098f\u09a8</p>\n                </div>\n                <div class=\"col-xs-8 padding-left-none\">\n                    <p>: {{ doc.tax_id or \"\" }}</p>\n                </div>\n                <div class=\"col-xs-4 customer-info\" style=\"font-weight: bold;\">\n                    <p>\u0995\u09cd\u09b0\u09c7\u09a4\u09be\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be</p>\n                </div>\n                <div class=\"col-xs-8 padding-left-none\">\n                    <p>: {{ doc.address_display or \"\" }}</p>\n                </div>\n                <div class=\"col-xs-4 customer-info\" style=\"font-weight: bold;\">\n                    <p>\u09b8\u09b0\u09ac\u09b0\u09be\u09b9\u09c7\u09b0 \u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af\u09b8\u09cd\u09a5\u09b2</p>\n                </div>\n                <div class=\"col-xs-8 padding-left-none\">\n                    <p>: {{ doc.shipping_address or \"\" }}</p>\n                </div>\n                <div class=\"col-xs-4 customer-info\" style=\"font-weight: bold;\">\n                    <p>\u09af\u09be\u09a8\u09ac\u09be\u09b9\u09a8\u09c7\u09b0 \u09aa\u09cd\u09b0\u0995\u09c3\u09a4\u09bf \u0993 \u09a8\u09ae\u09cd\u09ac\u09b0</p>\n                </div>\n                <div class=\"col-xs-8 padding-left-none\">\n                    <p>: {{ doc.custom_vehicle_type or \"\" }}, {{ doc.custom_vehicle_number or \"\" }}</p>\n                </div>\n            </div>\n        </div>\n        <div class=\"col-xs-5 text-left\">\n            <div class=\"row\" style= \"line-height: 14px; margin-top: 3px !important;\">\n                <div class=\"col-xs-5 customer-info\" style=\"font-weight: bold;\">\n                    <p>\u099a\u09be\u09b2\u09be\u09a8\u09aa\u09a4\u09cd\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0</p>\n                </div>\n                <div class=\"col-xs-7 padding-left-none\">\n                    <p>: {{ doc.name or \"\" }}</p>\n                </div>\n                <div class=\"col-xs-5 customer-info\" style=\"font-weight: bold;\">\n                    <p>\u0987\u09b8\u09cd\u09af\u09c1\u09b0 \u09a4\u09be\u09b0\u09bf\u0996</p>\n                </div>\n                <div class=\"col-xs-7 padding-left-none\">\n                    <p>: {{ doc.get_formatted('posting_date') }}</p>\n                </div>\n                <div class=\"col-xs-5 customer-info\" style=\"font-weight: bold;\">\n                    <p>\u0987\u09b8\u09cd\u09af\u09c1\u09b0 \u09b8\u09ae\u09df</p>\n                </div>\n                <div class=\"col-xs-7 padding-left-none\">\n                    <p>: {{ doc.get_formatted('posting_time') }}</p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <table class=\"table table-bordered\" style=\"border-color:black; margin-bottom: 2px; margin-top: 6px;\">\n    \t<tbody style=\"font-size: 10px;\">\n    \t\t<tr>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u0995\u09cd\u09b0\u09ae\u09bf\u0995</th>\n    \t\t\t<th class=\"text-center\" style=\"width:10rem; padding : 3px !important;\">\u09aa\u09a3\u09cd\u09af \u09ac\u09be \u09b8\u09c7\u09ac\u09be\u09b0 \u09ac\u09b0\u09cd\u09a3\u09a8\u09be (\u09aa\u09cd\u09b0\u09af\u09cb\u099c\u09cd\u09af \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09c7 \u09ac\u09cd\u09b0\u09be\u09a8\u09cd\u09a1 \u09a8\u09be\u09ae\u09b8\u09b9)</th>\n    \t\t\t<th style=\"width:2rem; padding : 3px !important;\" class=\"text-center\">\u09b8\u09b0\u09ac\u09b0\u09be\u09b9\u09c7\u09b0 \u098f\u0995\u0995</th>\n    \t\t\t<th style=\"width:2rem; padding : 3px !important;\" class=\"text-center\">\u09aa\u09b0\u09bf\u09ae\u09be\u09a3</th>\n    \t\t\t<th class=\"text-center\" style=\"width:5rem; padding : 3px !important;\">\u098f\u0995\u0995 \u09ae\u09c2\u09b2\u09cd\u09af(\u09e7) (\u099f\u09be\u0995\u09be\u09af\u09bc)</th>\n    \t\t\t<th class=\"text-center\" style=\"width:5rem; padding : 3px !important;\" >\u09ae\u09cb\u099f \u09ae\u09c2\u09b2\u09cd\u09af (\u099f\u09be\u0995\u09be\u09af\u09bc)</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u0995 \u09b6\u09c1\u09b2\u09cd\u0995\u09c7\u09b0 \u09b9\u09be\u09b0</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u0995 \u09b6\u09c1\u09b2\u09cd\u0995\u09c7\u09b0 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3 (\u099f\u09be\u0995\u09be\u09af\u09bc)</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09ae\u09c2\u09b2\u09cd\u09af \u09b8\u0982\u09af\u09cb\u099c\u09a8 \u0995\u09b0/\u09b8\u09c1\u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c7\u09b0 \u09b9\u09be\u09b0</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09ae\u09c2\u09b2\u09cd\u09af \u09b8\u0982\u09af\u09cb\u099c\u09a8 \u0995\u09b0/\u09b8\u09c1\u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c7\u09b0 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3(\u099f\u09be\u0995\u09be\u09af\u09bc)</th>\n    \t\t\t<th class=\"text-center\" style=\"width:5rem; padding : 3px !important;\">\u09b8\u0995\u09b2 \u09aa\u09cd\u09b0\u0995\u09be\u09b0 \u09b6\u09c1\u09b2\u09cd\u0995 \u0995\u09b0\u09b8\u09b9 \u09ae\u09c2\u09b2\u09cd\u09af</th>\n    \t\t</tr>\n    \t\t\n    \t\t<tr style=\"font-size: smaller;\">\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09e7</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09e8</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09e9</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09ea</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09eb</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09ec</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09ed</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09ee</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09ef</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09e7\u09e6</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">\u09e7\u09e7</th>\n    \t\t</tr>\n    \t\t{%- for row in doc.items -%}\n    \t\t<tr style=\"font-size: smaller;\">\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ row.idx }}</td>\n            \t<td style=\"padding : 3px !important;\">{{ row.item_name }}</td>\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ row.uom or \"\"}}</td>\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ row.qty }}</td>\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ frappe.format(row.rate, {'fieldtype': 'Currency'}).split(' ')[1] or \"\" }}</td>\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ frappe.format(row.amount, {'fieldtype': 'Currency'}).split(' ')[1] or \"\" }}</td>\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ row.supplementary_tax_rate or \"-\" }}</td>\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ row.supplementary_tax_amount or \"-\" }}</td>\n            \t\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">\n            \t\t{%- set tax_template = frappe.get_doc(\"Item Tax Template\", row.item_tax_template) if row.item_tax_template else None -%}\n            \t\t{%- set tax_percent = 0 -%}\n            \t\t{%- if tax_template and tax_template.taxes -%}\n            \t\t\t{%- set tax_percent = tax_template.taxes | sum(attribute='tax_rate') -%}\n            \t\t\t{{ frappe.format(tax_percent, {'fieldtype': 'Percent'}) }}\n            \t\t{%- else -%}\n            \t\t\t-\n            \t\t{%- endif -%}\n            \t</td>\n            \n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">\n                \t{%- if tax_percent -%}\n                \t    {% set tax_amount = row.amount * tax_percent / 100 %}\n            \t\t\t{{ frappe.format((tax_amount), {'fieldtype': 'Currency'}).split(' ')[1] }}\n            \t\t{%- else -%}\n            \t\t\t-\n            \t\t{%- endif -%}\n                </td>\n                \n                <td class=\"text-center\" style=\"padding : 3px !important;\">\n                \t{%- set total_with_tax = (row.amount + tax_amount) if tax_amount else row.amount -%}\n                \t{{ frappe.format(total_with_tax, {'fieldtype': 'Currency'}).split(' ')[1] }}\n                </td>\n            </tr>\n    \t\t{%- endfor -%}\n    \t\t<tr style=\"font-size: smaller;\">\n    \t\t    <td style=\"padding: 5px 6px !important;\"><strong></strong></td>\n    \t\t    <td style=\"padding: 1px 9px !important; font-size: 11px; text-center\"><p><strong>\u09b8\u09b0\u09cd\u09ac\u09ae\u09cb\u099f =</p></strong>\n    \t\t    <td style=\"padding: 5px 6px !important;\"><strong></strong></td>\n    \t\t    <td style=\"padding: 5px 6px !important;\"><strong></strong></td>\n    \t\t    <td class=\"text-center\" style=\"padding : 3px !important;\"><strong></strong></td>\n    \t\t    <td class=\"text-center\" style=\"padding : 3px !important;\"><strong>{{ frappe.format((doc.total), {'fieldtype': 'Currency'}).split(' ')[1] or \"\" }}</strong></td>\n    \t\t\t<td style=\"padding: 5px 6px !important;\"><strong></strong></td>\n    \t\t\t<td style=\"padding: 5px 6px !important;\"><strong></strong></td>\n    \t\t\t<td style=\"padding: 5px 6px !important;\"><strong></strong></td>\n    \t\t\t<td class=\"text-center\" style=\"padding : 3px !important;\"><strong>{{ frappe.format((doc.total_taxes_and_charges), {'fieldtype': 'Currency'}).split(' ')[1] or \"\" }}</strong></td>\n    \t\t\t<td class=\"text-center\" style=\"padding : 3px !important;\"><strong>{{ frappe.format((doc.grand_total), {'fieldtype': 'Currency'}).split(' ')[1] or \"\" }}</strong></td>\n    \t\t</tr>\n    \t</tbody>\n    </table>\n    <p style=\"font-size:10px; margin-top:0px;\">(\u09e7) \u09b8\u0995\u09b2 \u09aa\u09cd\u09b0\u0995\u09be\u09b0 \u0995\u09b0 \u09ac\u09cd\u09af\u09a4\u09c0\u09a4 \u09ae\u09c2\u09b2\u09cd\u09af</p>\n    <br>\n\n    <div class=\"row section-break\" style=\"font-size: 11px;\">\n        <div class=\"col-xs-12\">\n            <p style=\"margin-bottom: 20px;\">\u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09be\u09a8 \u0995\u09b0\u09cd\u09a4\u09c3\u09aa\u0995\u09cd\u09b7\u09c7\u09b0 \u09a6\u09be\u09df\u09bf\u09a4\u09cd\u09ac\u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09a4 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u09b0</p>\n        </div>\n        \n        <div class=\"col-xs-6\">\n            <div class=\"row\" style=\"margin-top: 5px !important;\">\n                <div class=\"col-xs-2\">\n                    <p>\u09a8\u09be\u09ae</p>\n                </div>\n                <div class=\"col-xs-10\">\n                    <p>: {{ doc.owner_name or \"____________________________\" }}</p>\n                </div>\n            </div>\n            <div class=\"row\" style=\"margin-top: 15px !important;\">\n                <div class=\"col-xs-2\">\n                    <p>\u09b8\u09cd\u09ac\u09be\u0995\u09cd\u09b7\u09b0</p>\n                </div>\n                <div class=\"col-xs-10\">\n                       : __________________________\n                </div>\n            </div>\n        </div>\n        <div class=\"col-xs-6\">\n            <div class=\"row\" style=\"margin-top: 5px !important;\">\n                <div class=\"col-xs-2\">\n                    <p>\u09aa\u09a6\u09ac\u09c0</p>\n                </div>\n                <div class=\"col-xs-10\">\n                    <p>: {{ doc.designation or \"____________________________\" }}</p>\n                </div>\n            </div>\n            <div class=\"row\" style=\"margin-top: 15px !important;\">\n                <div class=\"col-xs-2\">\n                    <p>\u09b8\u09c0\u09b2</p>\n                </div>\n                <div class=\"col-xs-10\">\n                       : __________________________\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<div class=\"pagebreak\"> </div>\n</div>\n{% endfor %}",
