 "html": "{% set month = [\"First \",\"Second\"] %} \n{% for n in month %}\n<div class=\"section-break\" data-label=\"\"> \n\n<div class=\"\">\n    <div id=\"header-html\" class=\"hidden-pdf\"> \n        <div class=\"row section-break\">\n            <div class=\"col-xs-2 text-left\">\n                <div class=\"logo\">\n                    <img style=\"width: 64px;\" src=\"/assets/vat_compliance/img/govt_logo.png\">\n                </div>\n            </div>\n            <div class=\"col-xs-8 text-center\">\n                <h4 style=\"padding:0px; margin:1px;font-size:12px\"><b>Government of the People's Republic of Bangladesh</b></h4>\n                <h4 style=\"padding:0px; margin:1px;font-size:12px\"><b>National Board of Revenue</b></h4> <br>\n                <h4 style=\"padding:0px; margin:1px;font-size:12px\">Tax Invoice</h4>\n                <p style=\"padding:0px;margin:1px;font-size:11px\">[ Rule 40(1)(ga) and (cha) ]</p>\n            </div>\n            <div class=\"col-xs-2 text-left\">\n                <br>\n                <p style=\"padding:0px; margin:1px; border:1px solid black; text-align:center;font-weight:bold;font-size:10px\">MUSHAK 6.3 {% if doc.docstatus == 0 %} [Draft] {%endif%}</p>\n                <p style=\"padding:0px; margin:1px;font-size:10px\">{{ n }} copy</p>\n            </div>\n        </div>\n        <div class=\"row section-break\" style=\"font-size: 11px;\">\n            <div class=\"col-xs-3\"></div>\n            <div class=\"row col-xs-9 text-left\" style=\"margin-top: 5px !important;\">\n                <div>\n                    <div class=\"col-xs-5\" style=\"font-weight:bold;\">\n                        <p style=\"font-size:10px\">Name of Registered Person</p>\n                    </div>\n                    <div class=\"col-xs-7\">\n                        <p style=\"font-size:10px\">: {{ doc.company or \"\" }}</p>\n                    </div>\n                    <div class=\"col-xs-5\" style=\"font-weight:bold;\">\n                        <p  style=\"font-size:10px\">BIN of Registered Person</p>\n                    </div>\n                    <div class=\"col-xs-7\">\n                        <p  style=\"font-size:10px\">: {{ doc.company_tax_id or \"\" }}</p>\n                    </div>\n                    <div class=\"col-xs-5\" style=\"font-weight:bold;\">\n                        <p  style=\"font-size:10px\">Challan Issuing Address</p>\n                    </div>\n                    <div class=\"col-xs-7\">\n                        {% if doc.company_address_display %}\n                        {% endif %}\n                        <p  style=\"font-size:10px\">:{{ doc.company_address_display or \"\" }}</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"row section-break\" style=\"font-size: 10px;\">\n        <div class=\"col-xs-7 text-left\">\n            <div class=\"row\" style= \"line-height: 12px;margin-top: 3px !important;\">\n                <div class=\"col-xs-6 customer-info\" style=\"font-weight: bold;\">\n                    <p>Name of Purchaser</p>\n                </div>\n                <div class=\"col-xs-6 padding-left-none\">\n                    <p>: {{ doc.customer_name }}</p>\n                </div>\n                <div class=\"col-xs-6 customer-info\" style=\"font-weight: bold;\">\n                    <p>BIN of Purchaser</p>\n                </div>\n                <div class=\"col-xs-6 padding-left-none\">\n                    <p>: {{ doc.tax_id or \"\" }}</p>\n                </div>\n                <div class=\"col-xs-6 customer-info\" style=\"font-weight: bold;\">\n                    <p>Address of Purchaser</p>\n                </div>\n                <div class=\"col-xs-6 padding-left-none\">\n                    <p>: {{ doc.address_display or \"\" }}</p>\n                </div>\n                <div class=\"col-xs-6 customer-info\" style=\"font-weight: bold;\">\n                    <p>Destination of Supply</p>\n                </div>\n                <div class=\"col-xs-6 padding-left-none\">\n                    <p>: {{ doc.shipping_address or \"\" }}</p>\n                </div>\n                <div class=\"col-xs-6 customer-info\" style=\"font-weight: bold;\">\n                    <p>Nature and Number of Vehicle</p>\n                </div>\n                <div class=\"col-xs-6 padding-left-none\">\n                    <p>: {{ doc.custom_vehicle_number or \"\" }} {{ doc.custom_vehicle_type or \"\" }}</p>\n                </div>\n            </div>\n        </div>\n        <div class=\"col-xs-5 text-left\">\n            <div class=\"row\" style= \"line-height: 12px;margin-top: 3px !important;\">\n                <div class=\"col-xs-5 customer-info\" style=\"font-weight: bold;\">\n                    <p>Invoice No</p>\n                </div>\n                <div class=\"col-xs-7 padding-left-none\">\n                    <p>: {{ doc.name or \"\" }}</p>\n                </div>\n                <div class=\"col-xs-5 customer-info\" style=\"font-weight: bold;\">\n                    <p>Date of Issue</p>\n                </div>\n                <div class=\"col-xs-7 padding-left-none\">\n                    <p>: {{ doc.get_formatted('posting_date') }}</p>\n                </div>\n                <div class=\"col-xs-5 customer-info\" style=\"font-weight: bold;\">\n                    <p>Time of Issue</p>\n                </div>\n                <div class=\"col-xs-7 padding-left-none\">\n                    <p>: {{ doc.get_formatted('posting_time') }}</p>\n                </div>\n            </div>\n        </div>\n        \n    </div>\n    <table class=\"table table-bordered\" style=\"border-color:black; margin-bottom: 2px; margin-top: 6px;\">\n    \t<tbody style=\"font-size: x-small;\">\n    \t\t<tr>\n    \t\t\t<th style=\"padding : 3px !important;\">SL#</th>\n    \t\t\t<th class=\"text-center\" style=\"width:10rem; padding : 3px !important;\">Goods/Service Description(Incases with Brand Name</th>\n    \t\t\t<th style=\"width:2rem; padding : 3px !important;\" class=\"text-center\">Unit of Supply</th>\n    \t\t\t<th style=\"width:2rem; padding : 3px !important;\" class=\"text-center\">Quantity</th>\n    \t\t\t<th class=\"text-center\" style=\"width:5rem; padding : 3px !important;\">Unit Value1 (TAKA)</th>\n    \t\t\t<th class=\"text-center\" style=\"width:5rem; padding : 3px !important;\" >Total Value1 (TAKA)</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">Supplementary Duty rate</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">Amount Supplementary Duty (TAKA)</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">Value Added Tax rate/ Specific Tax</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">Value Added Tax rate/ Specific Tax Amount(TAKA)</th>\n    \t\t\t<th class=\"text-center\" style=\"width:5rem; padding : 3px !important;\">Value all kinds of Duty & Tax</th>\n    \t\t</tr>\n    \t\t\n    \t\t<tr style=\"font-size: smaller;\">\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">1</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">2</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">3</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">4</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">5</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">6</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">7</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">8</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">9</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">10</th>\n    \t\t\t<th class=\"text-center\" style=\"padding : 3px !important;\">11</th>\n    \t\t</tr>\n    \t\t{%- for row in doc.items -%}\n    \t\t<tr style=\"font-size: smaller;\">\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ row.idx }}</td>\n            \t<td style=\"padding : 3px !important;\">{{ row.item_name }}</td>\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ row.uom or \"\"}}</td>\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ row.qty }}</td>\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ frappe.format(row.rate, {'fieldtype': 'Currency'}).split(' ')[1] or \"\" }}</td>\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ frappe.format(row.amount, {'fieldtype': 'Currency'}).split(' ')[1] or \"\" }}</td>\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ row.supplementary_tax_rate or \"-\" }}</td>\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">{{ row.supplementary_tax_amount or \"-\" }}</td>\n            \t\n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">\n            \t\t{%- set tax_template = frappe.get_doc(\"Item Tax Template\", row.item_tax_template) if row.item_tax_template else None -%}\n            \t\t{%- set tax_percent = 0 -%}\n            \t\t{%- if tax_template and tax_template.taxes -%}\n            \t\t\t{%- set tax_percent = tax_template.taxes | sum(attribute='tax_rate') -%}\n            \t\t\t{{ frappe.format(tax_percent, {'fieldtype': 'Percent'}) }}\n            \t\t{%- else -%}\n            \t\t\t-\n            \t\t{%- endif -%}\n            \t</td>\n            \n            \t<td class=\"text-center\" style=\"padding : 3px !important;\">\n                \t{%- if tax_percent -%}\n                \t    {% set tax_amount = row.amount * tax_percent / 100 %}\n            \t\t\t{{ frappe.format((tax_amount), {'fieldtype': 'Currency'}).split(' ')[1] }}\n            \t\t{%- else -%}\n            \t\t\t-\n            \t\t{%- endif -%}\n                </td>\n                \n                <td class=\"text-center\" style=\"padding : 3px !important;\">\n                \t{%- set total_with_tax = (row.amount + tax_amount) if tax_amount else row.amount -%}\n                \t{{ frappe.format(total_with_tax, {'fieldtype': 'Currency'}).split(' ')[1] }}\n                </td>\n\n            </tr>\n\n\n    \t\t{%- endfor -%}\n    \t\t<tr style=\"font-size: smaller;\">\n    \t\t    <td style=\"padding: 5px 6px !important;\"><strong></strong></td>\n    \t\t    <td style=\"padding: 1px 9px !important; font-size: 11px; text-center\"><p><strong>Total =</p></strong>\n    \t\t    <td style=\"padding: 5px 6px !important;\"><strong></strong></td>\n    \t\t    <td style=\"padding: 5px 6px !important;\"><strong></strong></td>\n    \t\t    <td class=\"text-center\" style=\"padding : 3px !important;\"><strong></strong></td>\n    \t\t    <td class=\"text-center\" style=\"padding : 3px !important;\"><strong>{{ frappe.format((doc.total), {'fieldtype': 'Currency'}).split(' ')[1] or \"\" }}</strong></td>\n    \t\t\t<td style=\"padding: 5px 6px !important;\"><strong></strong></td>\n    \t\t\t<td style=\"padding: 5px 6px !important;\"><strong></strong></td>\n    \t\t\t<td style=\"padding: 5px 6px !important;\"><strong></strong></td>\n    \t\t\t<td class=\"text-center\" style=\"padding : 3px !important;\"><strong></strong></td>\n    \t\t\t<td class=\"text-center\" style=\"padding : 3px !important;\"><strong>{{ frappe.format((doc.grand_total), {'fieldtype': 'Currency'}).split(' ')[1] or \"\" }}</strong></td>\n    \t\t</tr>\n    \t</tbody>\n    </table>\n    <br>\n    <div class=\"row section-break\" style=\"font-size: 10px;\">\n        <div class=\"col-xs-6\">\n            <div class=\"row\" style=\"margin-top: 2px !important;\">\n                <div class=\"col-xs-6\">\n                    <p>Name of organization Officer-in-charge</p>\n                </div>\n                <div class=\"col-xs-6\">\n                    <p>: ____________________________</p>\n                </div>\n            </div>\n            <div class=\"row\" style=\"margin-top: 2px !important;\">\n                <div class=\"col-xs-6\">\n                    <p>Designation</p>\n                </div>\n                <div class=\"col-xs-6\">\n                    <p>: ____________________________</p>\n                </div>\n            </div>\n            <div class=\"row\" style=\"margin-top: 2px !important;\">\n                <div class=\"col-xs-6\">\n                    <p>Signature</p>\n                </div>\n                <div class=\"col-xs-6\">\n                       : __________________________\n                </div>\n            </div>\n        </div>\n        <div class=\"col-xs-6\">\n            <div class=\"row\" style=\"margin-top: 2px !important;\">\n                <div class=\"col-xs-3\">\n                    <p>Seal</p>\n                </div>\n                <div class=\"col-xs-9\">\n                       : __________________________\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<p style=\"font-size:10px\">1Value except all kinds of Tax\u201d ;</p>\n<div class=\"pagebreak\"> </div>\n</div>\n{% endfor %}\n",
