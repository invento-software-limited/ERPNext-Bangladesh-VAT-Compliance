 "html": "<div class=\"wht-print\">\n\t<style>\n\t\t@page { size: A4 portrait; margin: 18mm 15mm 20mm; }\n\n\t\t/* Prefix everything with wht- to avoid Frappe conflicts */\n\t\t.wht-print {\n\t\t\tfont-family: \"Times New Roman\", serif;\n\t\t\tfont-size: 12px;\n\t\t\tcolor: #111;\n\t\t\tpadding: 10px;\n\t\t}\n\n\t\t.wht-header {\n\t\t\tposition: relative;\n\t\t\ttext-align: center;\n\t\t\tline-height: 1.4;\n\t\t\tmargin-bottom: 20px;\n\t\t}\n\n\t\t.wht-header-logo {\n\t\t\tposition: absolute;\n\t\t\ttop: 0;\n\t\t\tleft: 0;\n\t\t\twidth: 60px;\n\t\t\theight: 60px;\n\t\t\tobject-fit: contain;\n\t\t}\n\n\t\t.wht-badge {\n\t\t\tposition: absolute;\n\t\t\ttop: 0;\n\t\t\tright: 0;\n\t\t\tborder: 1px solid #000;\n\t\t\tpadding: 6px 14px;\n\t\t\tfont-weight: 700;\n\t\t\tletter-spacing: 1px;\n\t\t}\n\n\t\t.wht-title { font-weight: 600; margin-top: 8px; }\n\t\t.wht-rule { font-size: 11px; margin-bottom: 6px; }\n\n\t\t.wht-meta {\n\t\t\tmargin: 14px 0;\n\t\t\tline-height: 1.55;\n\t\t\ttext-align: center;\n\t\t}\n\n\t\t.wht-meta div { margin: 2px 0; }\n\n\t\t.wht-row {\n\t\t\tdisplay: flex;\n\t\t\tjustify-content: space-between;\n\t\t\tmargin-top: 8px;\n\t\t\tpadding: 0 15px;\n\t\t}\n\n\t\t.wht-row span { font-weight: 600; }\n\n\t\t.wht-table {\n\t\t\tborder-collapse: collapse;\n\t\t\twidth: 100%;\n\t\t\tfont-size: 11px;\n\t\t\tmargin-top: 20px;\n\t\t}\n\n\t\t.wht-table th,\n\t\t.wht-table td {\n\t\t\tborder: 1px solid #000;\n\t\t\tpadding: 6px 8px;\n\t\t\tvertical-align: middle;\n\t\t}\n\n\t\t.wht-table th {\n\t\t\ttext-align: center;\n\t\t\tfont-weight: 600;\n\t\t}\n\n\t\t.wht-text-center { text-align: center; }\n\t\t.wht-text-right { text-align: right; }\n\n\t\t.wht-signature {\n\t\t\tmargin-top: 40px;\n\t\t\tline-height: 1.7;\n\t\t\tfloat: right;\n\t\t}\n\t</style>\n{% set context = parse_context(doc.context) %}\n\n\t<div class=\"wht-header\">\n\t\t<img src=\"/assets/vat_compliance/img/govt_logo.png\" alt=\"Govt Logo\" class=\"wht-header-logo\">\n\t\t<div class=\"wht-badge\">MUSHAK 6.6</div>\n\t\t<div>Government of the People's Republic of Bangladesh</div>\n\t\t<div><strong>National Board of Revenue</strong></div>\n\t\t<div class=\"wht-title\">Withholding Certificate</div>\n\t\t<div class=\"wht-rule\">[see Clauses (f) of Sub-Rule (1) of Rule 40]</div>\n\t</div>\n\n\t<div class=\"wht-meta\">\n\t\t<div>Name of Withholding Entity: <strong>{{ context.name_of_withholding_entity or \"\" }}</strong></div>\n\t\t<div>Address of Withholding Entity: <strong>{{ context.address_of_withholding_entity or \"\" }}</strong></div>\n\t\t<div>BIN of Withholding Entity (if applicable): <strong>{{ context.bin_of_withholding_entity or \"\" }}</strong></div>\n\t</div>\n\n\t<div class=\"wht-row\">\n\t\t<div><span>Certificate No:</span> {{ context.certificate_no or \"\" }}</div>\n\t\t<div><span>Date of Issue:</span> {{ context.date_of_issue or \"\" }}</div>\n\t</div>\n\n\t<table class=\"wht-table\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th rowspan=\"2\" style=\"width:6%;\">SL<br>No</th>\n\t\t\t\t<th colspan=\"2\">Supplier</th>\n\t\t\t\t<th colspan=\"2\">Concerned Tax Invoice</th>\n\t\t\t\t<th rowspan=\"2\" style=\"width:14%;\">Total Value of Supply<br>(TAKA)</th>\n\t\t\t\t<th rowspan=\"2\" style=\"width:14%;\">Amount of VAT<br>(TAKA)</th>\n\t\t\t\t<th rowspan=\"2\" style=\"width:16%;\">Amount of VAT Withheld<br>at Source (TAKA)</th>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<th style=\"width:18%;\">Name</th>\n\t\t\t\t<th style=\"width:14%;\">BIN</th>\n\t\t\t\t<th style=\"width:14%;\">Number</th>\n\t\t\t\t<th style=\"width:14%;\">Issue Date</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t    {% for data in context.withheld_data %}\n\t\t\t<tr>\n\t\t\t\t<td class=\"wht-text-center\">{{ data.sl_no or \"-\"  }}</td>\n\t\t\t\t<td>{{ data.supplier_name or \"-\"  }}</td>\n\t\t\t\t<td class=\"wht-text-center\">{{ data.supplier_bin or \"-\" }}</td>\n\t\t\t\t<td class=\"wht-text-center\">{{ data.inv_number or \"-\"  }}</td>\n\t\t\t\t<td class=\"wht-text-center\">{{ data.inv_posting_date or \"-\"  }}</td>\n\t\t\t\t<td class=\"wht-text-right\">{{ frappe.format(data.total_value_of_supply, {'fieldtype': 'Currency'}).split(' ')[1] or \"\" }}</td>\n\t\t\t\t<td class=\"wht-text-right\">{{ frappe.format(data.amount_of_vat, {'fieldtype': 'Currency'}).split(' ')[1] or \"\" }}</td>\n\t\t\t\t<td class=\"wht-text-right\">{{ frappe.format(data.amount_of_vat_withheld, {'fieldtype': 'Currency'}).split(' ')[1] or \"\" }}</td>\n\t\t\t</tr>\n\t\t\t{% endfor %}\n\t\t</tbody>\n\t</table>\n\n\t<div class=\"wht-signature\">\n    <div>Officer-in-charge:</div>\n    <div>\n        Signature: \n            __________________________\n    </div>\n    <div>Name: ____________________________</div>\n</div>\n</div>",
